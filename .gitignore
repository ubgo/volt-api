vendor

# ignore all files starting with . or ~
##.*
~*
_*
.env*
# ...but the generated config contract is the thing new developers read: it
# lists every key with its doc line and default, and secrets are emitted EMPTY
# by design. env.sample carries only the deploy/CI variables, so without this
# negation the application's 44 settings would be documented nowhere.
!.env.example

# ignore OS generated files
.sass-cache
.DS_Store
ehthumbs.db
Thumbs.db
*.idea
*.TMP
*.tmp
.vscode-upload.json
node_modules/
yarn.lock

# ignore Golang related files
gin-bin
go.sum

# Other
/uploads/
trash

# fm
logs/*
!logs/.gitkeep
tmp/*
!tmp/.gitkeep
!tmp/bin/.gitkeep

ignore.md
saas/cmd/test

.github/.secrets
.github/.secrets.**

## ignore symlink directories for claude ai
thewildai_chat_node
thewildai_chat_rr

shell

.github/.secrets.*
.claude/settings.local.json

# build output from module tasks (e.g. task saas:build → ../tmp/bin)
modules/*/tmp/
modules/tmp/

# Binaries built in place by `go build ./cmd/<name>` — the Taskfile writes to
# tmp/bin/, but a bare `go build` drops one next to the source.
modules/webapp/cli
modules/webapp/api
modules/webapp/cron
