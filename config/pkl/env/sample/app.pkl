amends "../../schema/Root.pkl"

server {
  hostname = "localhost"
  port = "2315"
}

core {
  appName = "demo"
  appKey = "demo"
  environment = "dev"
  rootdir = "/Volumes/D/www/projects/demo"
  tmpdir = core.rootdir + "/tmp"
  uploadsdir = core.rootdir + "/uploads"
  internalKey = "1234"
  jwtsecret = "xxxx"
  encryptionKey = "xxxx"
}

nats {
  status = true
  appKey = "demo-local"
  // url = "nats://localhost:4222"
  url = "tls://connect.ngs.global"
  credsFile = "/Volumes/D/_keys/nsg-default-cli-30Vc7OilhLCxYqCddsbV4oENtkS.creds"
}

database {
  host = "localhost"
  port = 5432
  username = "postgres"
  password = "root"
  dbName = "demo_db"
  sslmode = "disable"
}

graphql {
  key = "1234"
}

otel {
  enable = true

  endpoint = "in-otel.hyperdx.io"
  apiKey = "xxxx"
  isEndpoingUrl = false
  prefixBasic = false

  // grafana
  // isEndpoingUrl = true
  // endpoint = "https://otlp-gateway-prod-eu-west-2.grafana.net/otlp"
  // apiKey = "xxxx"
  // prefixBasic = true

  insecure = false
  enableMetrics = false
  enableLogs = true
  enableTraces = true
  serviceName = "demo"
  serviceVersion = "1.0.0"
  enableHttp = true
  enableStdout = true
}

logger {
  enableStdout = true
  enableOtel = true
  enableFile = true
  localConfig {
    enabled = true
    logFile = core.rootdir + "/logs/app.log"
  }
}

app {
  reactAppHost = "http://localhost:3000"
  apiKeys {
    openai = "xxxx"
  }
  gocron {
    uiEnable = false
    uiPort = "2316"
    enabledJobs {}
  }
}
