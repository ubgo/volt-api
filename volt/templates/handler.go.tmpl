// Handler handles {{name}} HTTP requests.
type Handler struct {
	service *Service
	logger  *ulog.Logger
}

// NewHandler creates a new {{Name}} handler.
func NewHandler(service *Service, logger *ulog.Logger) *Handler {
	return &Handler{
		service: service,
		logger:  logger,
	}
}

// RegisterRoutes registers {{name}} routes on the router group.
func (h *Handler) RegisterRoutes(rg *gin.RouterGroup) {
	g := rg.Group("/{{name}}s")
	{
		g.GET("", h.List)
		g.GET("/:id", h.Get)
		g.POST("", h.Create)
		g.PUT("/:id", h.Update)
		g.DELETE("/:id", h.Delete)
	}
}

// List godoc
// @Summary List {{name}}s
// @Tags {{name}}s
// @Success 200 {array} {{Name}}Response
// @Router /{{name}}s [get]
func (h *Handler) List(c *gin.Context) {
	ctx := c.Request.Context()

	results, err := h.service.List(ctx)
	if err != nil {
		h.logger.Error("list {{name}}s failed", ulog.Err(err))
		c.JSON(http.StatusInternalServerError, gin.H{"error": "internal error"})
		return
	}

	c.JSON(http.StatusOK, results)
}

// Get godoc
// @Summary Get {{name}} by ID
// @Tags {{name}}s
// @Param id path string true "{{Name}} ID"
// @Success 200 {object} {{Name}}Response
// @Router /{{name}}s/{id} [get]
func (h *Handler) Get(c *gin.Context) {
	ctx := c.Request.Context()
	id := c.Param("id")

	result, err := h.service.Get(ctx, id)
	if err != nil {
		h.logger.Error("get {{name}} failed", ulog.Err(err), ulog.String("id", id))
		c.JSON(http.StatusNotFound, gin.H{"error": "not found"})
		return
	}

	c.JSON(http.StatusOK, result)
}

