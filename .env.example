# optional · secret — do not commit a real value
OPENAI_API_KEY=

# job names to register; empty registers all
# optional
CRON_ENABLED_JOBS=

# optional
CRON_UI_ENABLE=true

# optional
CRON_UI_PORT=8089

# optional
REACT_APP_HOST=http://localhost:2312

# unique key for this microservice
# optional
APP_KEY=boilerplate_local

# human-readable application name
# optional
APP_NAME=boilerplate

# data encryption key
# optional · secret — do not commit a real value
ENCRYPTION_KEY=

# deployment environment: dev, stag or prod
# optional
CONFIG_ENV=dev

# service-to-service auth key
# optional · secret — do not commit a real value
INTERNAL_KEY=

# JWT signing secret
# optional · secret — do not commit a real value
JWT_SECRET=

# root directory; anchors tmp, uploads and logs
# optional
VOLT_ROOT=.

# defaults to <root>/tmp
# optional
TMP_DIR=

# defaults to <root>/uploads
# optional
UPLOADS_DIR=

# optional
DB_NAME=boilerplate_db

# optional
DB_HOST=localhost

# optional · secret — do not commit a real value
DB_PASSWORD=

# optional
DB_PORT=5432

# disable, require, verify-ca or verify-full
# optional
DB_SSLMODE=disable

# optional
DB_USERNAME=postgres

# optional · secret — do not commit a real value
GRAPHQL_KEY=

# optional
LOGGER_ENABLE_FILE=true

# optional
LOGGER_ENABLE_OTEL=false

# optional
LOGGER_ENABLE_STDOUT=true

# optional
LOGGER_LOCAL_ENABLED=true

# defaults to <tmp>/logs/app.log
# optional
LOGGER_LOG_FILE=

# optional · secret — do not commit a real value
OTEL_API_KEY=

# master switch for the OTEL middleware
# optional
OTEL_ENABLE=false

# optional
OTEL_ENABLE_HTTP=true

# optional
OTEL_ENABLE_LOGS=true

# optional
OTEL_ENABLE_METRICS=false

# optional
OTEL_ENABLE_STDOUT=true

# optional
OTEL_ENABLE_TRACES=true

# optional
OTEL_ENDPOINT=localhost:4317

# optional
OTEL_INSECURE=true

# optional
OTEL_IS_ENDPOINT_URL=false

# optional
OTEL_PREFIX_BASIC=false

# defaults to the app key
# optional
OTEL_SERVICE_NAME=

# optional
OTEL_SERVICE_VERSION=1.0.0

# optional
REDIS_DB=1

# enable the Redis cache
# optional
REDIS_STATUS=true

# optional
REDIS_URL=redis://default:@127.0.0.1:6379

# interface the HTTP server binds
# optional
HOSTNAME=localhost

# port the HTTP server listens on
# optional
PORT=9001
