# Code generated by secrets_build.go, DO NOT EDIT
# Deployment workflow for: [[ .Name ]]
# Branch: [[ .Branch ]] → Environment: [[ .Name ]]

name: Deploy [[ .Name ]]

on:
  push:
    branches:
      - [[ .Branch ]]
  workflow_dispatch:
    inputs:
      skip_build:
        description: 'Skip build and deploy existing latest image'
        required: false
        type: boolean
        default: false

env:
  REGISTRY: ghcr.io
  IMAGE_NAME: ${{ github.repository }}
  ENVIRONMENT: [[ .Name ]]

jobs:
  build-and-push:
    if: ${{ github.event.inputs.skip_build != 'true' }}
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          clean: false

      - name: Set up QEMU
        uses: docker/setup-qemu-action@v3

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Log in to Container Registry
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Extract metadata
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}
          tags: |
            type=sha,prefix=[[ .Name ]]-
            type=raw,value=[[ .Name ]]-latest

      - name: Set build variables
        id: vars
        run: |
          echo "commit=$(git rev-parse --short HEAD)" >> $GITHUB_OUTPUT
          echo "branch=$(git rev-parse --abbrev-ref HEAD)" >> $GITHUB_OUTPUT
          echo "build_time=$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> $GITHUB_OUTPUT

      - name: Build and push Docker image
        uses: docker/build-push-action@v5
        with:
          context: .
          file: .docker/Dockerfile.prod
          platforms: linux/amd64
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          build-args: |
            VERSION=${{ github.ref_name }}
            COMMIT=${{ steps.vars.outputs.commit }}
            BRANCH=${{ steps.vars.outputs.branch }}
            BUILD_TIME=${{ steps.vars.outputs.build_time }}
            ENVIRONMENT=[[ .Name ]]

  deploy:
    needs: build-and-push
    if: always() && (needs.build-and-push.result == 'success' || needs.build-and-push.result == 'skipped')
    runs-on: ubuntu-latest
    environment: [[ .Name ]]
    steps:
      - name: Decode SSH Key
        id: ssh_key
        run: |
          # Decode base64 SSH key and set as output
          echo "${{ secrets.[[ .SSHKeySecret ]] }}" | base64 -d > /tmp/ssh_key
          # Also set as env var for ssh-action
          {
            echo 'SSH_KEY<<EOF'
            cat /tmp/ssh_key
            echo ''
            echo 'EOF'
          } >> $GITHUB_OUTPUT

      - name: Deploy to VPS
        uses: appleboy/ssh-action@v1.0.3
        env:
          DEPLOY_PATH: ${{ secrets.DEPLOY_PATH }}
          IMAGE: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:[[ .Name ]]-latest
          CONTAINER: ${{ secrets.CONTAINER_NAME }}
          GHCR_PAT: ${{ secrets.GHCR_PAT }}
          REGISTRY: ${{ env.REGISTRY }}
          REPO_OWNER: ${{ github.repository_owner }}
          ENV_B64: ${{ secrets.ENV_B64 }}
          ENVIRONMENT: [[ .Name ]]
[[- range .KeyFiles ]]
          [[ .SecretName ]]: ${{ secrets.[[ .SecretName ]] }}
[[- end ]]
        with:
          host: ${{ secrets.VPS_HOST }}
          username: ${{ secrets.VPS_USER }}
          key: ${{ steps.ssh_key.outputs.SSH_KEY }}
          port: ${{ secrets.VPS_PORT }}
          envs: DEPLOY_PATH,IMAGE,CONTAINER,GHCR_PAT,REGISTRY,REPO_OWNER,ENV_B64,ENVIRONMENT[[ range .KeyFiles ]],[[ .SecretName ]][[ end ]]
          script: |
            set -e

            echo "==> Deploying to ${ENVIRONMENT} environment..."
            echo "==> Creating directories..."
            mkdir -p ${DEPLOY_PATH}/_keys
            mkdir -p ${DEPLOY_PATH}/logs

            echo "==> Fixing permissions for logs directory (container runs as UID 1000)..."
            chown -R 1000:1000 ${DEPLOY_PATH}/logs
[[- if .KeyFiles ]]

            echo "==> Writing key files..."
[[- range .KeyFiles ]]
            echo "${[[ .SecretName ]]}" | base64 -d > ${DEPLOY_PATH}/_keys/[[ .Filename ]]
[[- end ]]
            chmod 600 ${DEPLOY_PATH}/_keys/*
[[- end ]]

            echo "==> Writing .env.${ENVIRONMENT}..."
            echo "${ENV_B64}" | base64 -d > ${DEPLOY_PATH}/.env.${ENVIRONMENT}
            chmod 600 ${DEPLOY_PATH}/.env.${ENVIRONMENT}

            echo "==> Logging in to registry..."
            echo "${GHCR_PAT}" | docker login ${REGISTRY} -u ${REPO_OWNER} --password-stdin

            echo "==> Pulling image: ${IMAGE}..."
            docker pull ${IMAGE}

            echo "==> Stopping old container (waiting for graceful shutdown)..."
            docker stop ${CONTAINER} 2>/dev/null || true
            docker rm ${CONTAINER} 2>/dev/null || true

            echo "==> Reading PORT from .env.${ENVIRONMENT}..."
            PORT=$(grep -E '^PORT=' ${DEPLOY_PATH}/.env.${ENVIRONMENT} | cut -d '=' -f2 | tr -d ' ' || echo "2315")

            # --stop-timeout 86400 (24h) allows cron jobs to complete during deployments.
            echo "==> Starting new container on port ${PORT}..."
            docker run -d \
              --name ${CONTAINER} \
              --restart unless-stopped \
              --stop-timeout 86400 \
              --network host \
              --env-file ${DEPLOY_PATH}/.env.${ENVIRONMENT} \
              -v ${DEPLOY_PATH}/_keys:/app/_keys:ro \
              -v ${DEPLOY_PATH}/logs:/app/tmp/logs \
              ${IMAGE}

            echo "==> Waiting for container to be ready..."
            sleep 5

            echo "==> Running database migrations..."
            docker exec ${CONTAINER} /app/cli migrate

            echo "==> Cleaning up old images..."
            docker image prune -f

            echo "==> Deployment to ${ENVIRONMENT} complete!"
            docker ps | grep ${CONTAINER}
