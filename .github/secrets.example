# Copy this file to .secrets and fill in real values
# DO NOT commit .secrets to git!
GITHUB_ACTOR=thewildai

# only needed for `act` local testing no need to add to the github repo secrets
# GITHUB_TOKEN is special - GitHub Actions auto-generates it with proper permissions. It only works inside GitHub's runners
GITHUB_TOKEN=REDACTED_GITHUB_TOKEN

# VPS Access for auto demploy the github container to the VPS
VPS_HOST=your-vps-ip
VPS_USER=root
VPS_SSH_KEY="-----BEGIN OPENSSH PRIVATE KEY-----
your-key-content-here
-----END OPENSSH PRIVATE KEY-----"

# GitHub Container Registry
GHCR_PAT=ghp_your_pat_here

# Base64 encoded files (generate with: cat file | base64 | tr -d '\n')
ENV_PROD_B64=REDACTED_BASE64_ENV