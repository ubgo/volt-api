# ===================================
# Stage 1: Builder
# ===================================
# Use Go 1.25.5 Alpine (adjust version as needed for your project)
# Must be >= the highest `go` directive across modules/*/go.mod (1.26.4).
# It was 1.25.5 while apidash, dbent and webapp already required 1.26.4.
ARG GO_VERSION=1.26.4
FROM golang:${GO_VERSION}-alpine3.22 AS builder

# Build arguments for target architecture
ARG TARGETOS=linux
ARG TARGETARCH

# Install build dependencies
RUN apk add --no-cache git ca-certificates curl

# Set working directory
WORKDIR /build

# Set build environment
# GOTOOLCHAIN=auto allows Go to download the required version specified in go.work
ENV CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} GOTOOLCHAIN=auto

# Copy go.work and module files (go.sum files are generated by go work vendor)
COPY go.work go.work.sum ./
COPY modules/lace/go.mod ./modules/lace/
COPY modules/config/go.mod ./modules/config/
COPY modules/scripts/go.mod ./modules/scripts/
COPY modules/dbent/go.mod ./modules/dbent/
COPY modules/apidash/go.mod ./modules/apidash/
COPY modules/saas/go.mod ./modules/saas/
COPY modules/core/go.mod ./modules/core/

## CUSTOM
## AI: can be modified to include other custom modules
COPY modules/examples/go.mod ./modules/examples/
## END CUSTOM

# Copy source code
COPY modules/lace ./modules/lace
COPY modules/config ./modules/config
COPY modules/scripts ./modules/scripts
COPY modules/dbent ./modules/dbent
COPY modules/apidash ./modules/apidash
COPY modules/saas ./modules/saas
COPY modules/core ./modules/core

## CUSTOM
## AI: can be modified to include other custom modules
COPY modules/examples ./modules/examples
## END CUSTOM

# Download and vendor dependencies (instead of copying vendor directory)
RUN go work vendor

# Build arguments for version info
ARG VERSION=dev
ARG COMMIT=unknown
ARG BRANCH=unknown
ARG BUILD_TIME=unknown

# Build flags for version info
ENV LDFLAGS="-w -s \
    -X github.com/ubgo/buildinfo.Version=${VERSION} \
    -X github.com/ubgo/buildinfo.Commit=${COMMIT} \
    -X github.com/ubgo/buildinfo.Branch=${BRANCH} \
    -X github.com/ubgo/buildinfo.BuildTime=${BUILD_TIME}"

# Build all binaries: api, cron, cli, dbmigrate
RUN go build -mod=vendor -ldflags="${LDFLAGS}" -o /build/bin/api ./modules/saas/cmd/api && \
    go build -mod=vendor -ldflags="${LDFLAGS}" -o /build/bin/cron ./modules/saas/cmd/cron && \
    go build -mod=vendor -ldflags="${LDFLAGS}" -o /build/bin/cli ./modules/saas/cmd/cli

# ===================================
# Stage 2: Runtime
# ===================================
FROM alpine:3.22

# Install runtime dependencies
# supervisor for running multiple processes (api + cron)
#
# No config evaluator is installed. Configuration is compiled into the binary
# and overridden by environment variables, so the image no longer downloads a
# CLI at build time, no longer needs gcompat to run it, and no longer depends
# on a third-party release URL being reachable when the image is built.
RUN apk add --no-cache ca-certificates tzdata curl libstdc++ supervisor

# Create non-root user for security
RUN addgroup -g 1000 appgroup && \
    adduser -u 1000 -G appgroup -D appuser

# Set working directory
WORKDIR /app

# Create required directories
RUN mkdir -p /app/tmp/logs /app/_keys && \
    chown -R appuser:appgroup /app

# Copy binaries from builder
COPY --from=builder /build/bin/api /app/api
COPY --from=builder /build/bin/cron /app/cron
COPY --from=builder /build/bin/cli /app/cli

# No config files are copied: defaults are compiled into the binaries and the
# deployment supplies overrides as environment variables.

# Copy supervisord config
COPY .docker/supervisord.prod.conf /etc/supervisor/conf.d/supervisord.conf

# Set ownership
RUN chown -R appuser:appgroup /app

# Environment variables with defaults
# CONFIG_ENV selects the environment, which decides which validation rules
# apply — it no longer selects a config file to evaluate.
ENV CONFIG_ENV=prod

# Default port (can be overridden at runtime)
ENV PORT=2315

# Expose port (informational - actual port is dynamic)
EXPOSE ${PORT}

# Health check (using version endpoint)
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:${PORT}/api/version || exit 1

# Run as non-root user
USER appuser

# Run supervisor (manages both api and cron)
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
