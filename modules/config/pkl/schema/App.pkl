@go.Package { name = "config/gen/appconfig" }
module AppConfig

import "package://pkg.pkl-lang.org/pkl-go/pkl.golang@0.12.1#/go.pkl"

class ApiKeys {
  openai: String
}

class Gocron {
  uiEnable: Boolean
  uiPort: String
  /// List of job names to register. If empty, all jobs are registered.
  enabledJobs: Listing<String>
}

class Setting {
  reactAppHost: String
  apiKeys: ApiKeys
  gocron: Gocron
}
